    <element xsi:type="archimate:Capability" name="11.1. Формирование продуктовых предложений" id="id-753afff453bc4417a5f650bea22e510b"/>
    <element xsi:type="archimate:Capability" name="11.1.1. Разработка продуктов на базе цифрового рубля (сервисы для клиентов)" id="id-6d2a1bf259c54360b57cd99eee303f44">
      <documentation>Сервисы для клиентов</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="11.1.2. Планирование продуктовой линейки под новые возможности" id="id-d4c0fe2330dc4b0bb4347a0aba9c25ce">
      <documentation>Офлайн, программируемость, трансграничные расчёты</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="11.2. Управление коммерческой политикой" id="id-af1413dbd74a42ffbffc9403e3e5dcbb"/>
    <element xsi:type="archimate:Capability" name="11.2.1. Ценообразование на услуги с цифровым рублём" id="id-9aa66ee530f748d48a112652538bff7d"/>
    <element xsi:type="archimate:Capability" name="11.2.2. Стимулирование использования цифрового рубля" id="id-0012b9f47837498fb3e2d80f13ecc552">
      <documentation>Акции, лояльность</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="11.3. Анализ рынка и данных" id="id-f6bfd2bc83204def82346c73e45ed0e8"/>
    <element xsi:type="archimate:Capability" name="11.3.1. Анализ динамики оборота и адаптация" id="id-b5c739e535df402395d8787ef2cc03a2"/>
    <element xsi:type="archimate:Capability" name="11.3.2. Оценка эффектов для экономики" id="id-f423a627114e48e5bb958953ea90a04d">
      <documentation>M1, скорость обращения денег, теневая экономика</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="3.4. Управление ликвидностью цифровых рублей" id="id-e8913173f5c84ecbb1b33b7e13f46b9b">
      <documentation>Критично для банков-посредников: управление остатками на собственных счетах в платформе ЦБ (пул выпущенных цифровых рублей).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="3.4.1. Пополнение пула ликвидности на счёте в платформе ЦБ" id="id-a71acee839d64fc69e03e19bd79d7c7c">
      <documentation>Выпуск цифровых рублей под клиентский спрос</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="3.4.2. Изъятие избыточной ликвидности из платформы" id="id-0a951de3e0164201acb7284ad960af12">
      <documentation>Обратная конвертация в безналичные рубли</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="3.4.3. Прогнозирование спроса клиентов на цифровые рубли и планирование объёма пула" id="id-a7299b8963d4435fa5e17926cfb3daae"/>
    <element xsi:type="archimate:Capability" name="3.4.4. Установление внутренних лимитов ликвидности цифровых рублей" id="id-64bd353bb7a8442f8dd1cf2695d4cc73">
      <documentation>Прогнозирование спроса будет болевой точкой банков на первом этапе (нет истории оборота, лимиты пополнения клиентских кошельков по 300 тыс./мес)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="6.1. Управление жизненным циклом шаблонов условий" id="id-44463cc5e79f4c9a94aa841e34ce1174">
      <documentation>Про шаблон (типовую конструкцию, который банк/компания готовит, тестирует и регистрирует один раз, как «программный продукт»).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="6.1.1. Разработка шаблонов программируемых условий" id="id-32276fa801f944e599bac9dc649a98a8">
      <documentation>По сути, речь о смарт-контрактах.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="6.1.2. Тестирование и верификация шаблонов" id="id-7df5bb64a32d44b487cd2b3e7d3fb115">
      <documentation>В тестовой среде платформы ЦБ</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="6.1.3. Регистрация и сертификация шаблонов в платформе" id="id-1c5ccd3f9527406abe689fd468004a9b"/>
    <element xsi:type="archimate:Capability" name="6.1.4. Версионирование, изменение и отзыв шаблонов" id="id-98e4733657e9470a86e8960586eca169"/>
  </folder>

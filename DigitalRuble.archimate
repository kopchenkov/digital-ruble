    <element xsi:type="archimate:Capability" name="10.2.1. Отслеживание изменений нормативной базы и правил платформы" id="id-295388edef5148108eb4cd7233e1fa50"/>
    <element xsi:type="archimate:Capability" name="10.2.2. Планирование и выполнение доработок систем под новые версии платформы" id="id-85578f3a63234423801a56bd67cb4cc5"/>
    <element xsi:type="archimate:Capability" name="10.3. Эксплуатация решений" id="id-ab0c461b3c4648ab95431b5da60d9aa5"/>
    <element xsi:type="archimate:Capability" name="10.3.1. Мониторинг работоспособности и SLA" id="id-122d06a1c7e74f18bfd95112e90f37b8"/>
    <element xsi:type="archimate:Capability" name="10.3.2. Управление техническими инцидентами" id="id-fc5cdfa4f59646e3bae4ec284aa962d4"/>
